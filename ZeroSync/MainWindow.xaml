<Window x:Class="ZeroSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZeroSync.ViewModels"
        Title="ZeroSync — Rclone Sync Manager" 
        Width="780" Height="650" MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter" 
                                     xmlns:local="clr-namespace:ZeroSync.Core"/>
        <local:WatchStatusBrushConverter x:Key="WatchStatusBrushConverter" 
                                          xmlns:local="clr-namespace:ZeroSync.Core"/>
        <local:WatchStatusTextConverter x:Key="WatchStatusTextConverter" 
                                         xmlns:local="clr-namespace:ZeroSync.Core"/>
        <local:BoolToVisConverter x:Key="BoolToVisConverter" 
                                   xmlns:local="clr-namespace:ZeroSync.Core"/>
        <local:LogEntryColorConverter x:Key="LogEntryColorConverter" 
                                      xmlns:local="clr-namespace:ZeroSync.Core"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter" 
                                          xmlns:local="clr-namespace:ZeroSync.Core"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xF12B;" FontSize="22" 
                           Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="ZeroSync" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Profile Selector & Operations -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Profile:" Foreground="{StaticResource TextSecondaryBrush}" 
                           VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                
                <!-- Grid chuyển đổi Xem (ComboBox) và Đổi tên (TextBox) -->
                <Grid VerticalAlignment="Center">
                    <!-- Khi KHÔNG đổi tên -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenamingProfile, Converter={StaticResource InverseBoolToVisConverter}}">
                        <ComboBox Width="180" ItemsSource="{Binding Profiles}" 
                                  SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                  IsEnabled="{Binding CanChangeProfile}" VerticalAlignment="Center"/>
                        
                        <Button Height="28" Padding="10,0" Margin="6,0,0,0"
                                Command="{Binding StartRenameProfileCommand}" ToolTip="Đổi tên profile"
                                IsEnabled="{Binding CanChangeProfile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="Đổi tên" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Height="28" Padding="10,0" Margin="4,0,0,0"
                                Command="{Binding AddProfileCommand}" ToolTip="Thêm profile mới"
                                IsEnabled="{Binding CanChangeProfile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="Thêm" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Height="28" Padding="10,0" Margin="4,0,0,0"
                                Command="{Binding DeleteProfileCommand}" ToolTip="Xóa profile hiện tại"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding CanChangeProfile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="Xóa" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Khi ĐANG đổi tên -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenamingProfile, Converter={StaticResource BoolToVisConverter}}">
                        <TextBox Width="180" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalAlignment="Center" Height="26" FontSize="12" Padding="4,2"/>
                        
                        <Button Height="28" Padding="10,0" Margin="6,0,0,0"
                                Command="{Binding SaveRenameProfileCommand}" ToolTip="Xác nhận đổi tên"
                                Style="{StaticResource SuccessButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="Lưu" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Height="28" Padding="10,0" Margin="4,0,0,0"
                                Command="{Binding CancelRenameProfileCommand}" ToolTip="Hủy bỏ">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="Hủy" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Cảnh báo lỗi Profile -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasProfileError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="14" 
                               Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ProfileError}" FontSize="12" Foreground="{StaticResource AccentRedBrush}" 
                               VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="280"
                               ToolTip="{Binding ProfileError}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ TAB CONTENT ═══ -->
        <TabControl Grid.Row="1">

            <!-- ─── Tab: Sync ─── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock Text="Đồng bộ" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,4,0">
                    <StackPanel>

                        <!-- ─── BẢNG NHIỆM VỤ BACKUP (DATA GRID) ─── -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="📋 Danh sách nhiệm vụ đồng bộ" FontWeight="Bold" FontSize="14" 
                                               Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding AddTaskWithFolderCommand}" IsEnabled="{Binding CanEditTasks}" Margin="0,0,8,0" Style="{StaticResource AccentButton}" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xED25;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Thêm thư mục" VerticalAlignment="Center" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AddTaskCommand}" IsEnabled="{Binding CanEditTasks}" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Thêm dòng" VerticalAlignment="Center" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding BackupTasks}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" SelectionMode="Single" Height="190"
                                          Background="{StaticResource BgMediumBrush}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1" RowHeight="32"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          HeadersVisibility="Column"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="{StaticResource BgDarkBrush}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          IsEnabled="{Binding CanEditTasks}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#33007acc"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thư mục nguồn cục bộ (Source)" 
                                                            Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" 
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Remote đích (Destination)" 
                                                            Binding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" 
                                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Chế độ sync" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedIndex="{Binding SyncMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                              Height="24" FontSize="11" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="Copy"/>
                                                        <ComboBoxItem Content="Sync"/>
                                                        <ComboBoxItem Content="Move"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Bộ lọc tệp (Filter)" 
                                                            Binding="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" 
                                                            Width="110"/>
                                        <DataGridTemplateColumn Width="60" Header="Xóa">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButton}"
                                                            Height="24" Width="44" HorizontalAlignment="Center" Padding="0"
                                                            ToolTip="Xóa nhiệm vụ này"
                                                            IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                
                                <TextBlock Text="💡 Bạn có thể dán (Paste) đường dẫn trực tiếp vào bảng hoặc nhấn 'Thêm thư mục' để chọn bằng chuột." 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── THANH ĐIỀU KHIỂN TRUNG TÂM (CONTROL PANEL) ─── -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Nhóm Đồng bộ thủ công -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Height="34" Padding="14,0" Margin="0,0,8,0" Command="{Binding RunSyncCommand}" Style="{StaticResource SuccessButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <TextBlock Text="Chạy Sync" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34" Padding="14,0" Margin="0,0,8,0" Command="{Binding CancelSyncCommand}" Style="{StaticResource DangerButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Dừng Sync" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34" Padding="14,0" Command="{Binding TestConnectionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA86;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Test Kết Nối" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                
                                <!-- Nhóm Theo dõi (Watch Mode) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Height="34" Padding="14,0" Margin="0,0,8,0" Command="{Binding StartWatchCommand}" Style="{StaticResource AccentButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE890;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bật Watch" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34" Padding="14,0" Margin="0,0,8,0" Command="{Binding StopWatchCommand}" Style="{StaticResource DangerButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Dừng Watch" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34" Padding="14,0" Command="{Binding SaveConfigCommand}" ToolTip="Lưu cấu hình profile hiện tại">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ─── CẤU HÌNH NÂNG CAO (EXPANDER) ─── -->
                        <Expander Header="⚙ Cấu hình nâng cao &amp; Bộ lọc tệp tin" IsExpanded="False" 
                                  Margin="0,0,0,12" Background="{StaticResource BgMediumBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border Padding="12">
                                <StackPanel>
                                <!-- Mode & Quick Options -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="🔄 Chế độ sync"/>
                                        <ComboBox ItemsSource="{Binding SyncModes}" 
                                                  SelectedIndex="{Binding SelectedSyncMode}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Label Content="Tùy chọn nhanh"/>
                                        <CheckBox Content="Bỏ qua file đã tồn tại (--ignore-existing)" IsChecked="{Binding IgnoreExisting}" Margin="0,0,0,4"/>
                                        <CheckBox Content="Dry Run (chạy thử nghiệm)" IsChecked="{Binding DryRun}"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,12"/>

                                <!-- Watch Settings -->
                                <TextBlock Text="👁 Thiết lập theo dõi thư mục (Watch Mode)" FontWeight="Bold" FontSize="12.5"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Content="Tự động bật Watch khi khởi động Sync" IsChecked="{Binding WatchEnabled}" Margin="0,0,24,0"/>
                                    <CheckBox Content="Đồng bộ toàn bộ file khi bắt đầu Watch" IsChecked="{Binding SyncOnStartWatch}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="⏱ Debounce (giây)"/>
                                        <TextBox Text="{Binding DebounceSec, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Thời gian chờ sau thay đổi file cuối"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <Label Content="🔒 Lock timeout (giây)"/>
                                        <TextBox Text="{Binding FileLockTimeoutSec, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Thời gian chờ tối đa nếu file đang bị ghi"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Label Content="🔁 Thử lại sau (ms)"/>
                                        <TextBox Text="{Binding FileLockRetryMs, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Khoảng thời gian kiểm tra lại khóa file"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,12"/>

                                <!-- File Filter -->
                                <StackPanel Margin="0,4,0,4">
                                    <Label Content="Đầu lọc tệp tin (File Filter, ví dụ: *.bak;*.txt)"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Height="28"
                                                Command="{Binding ScanExtensionsCommand}"
                                                ToolTip="Quét các đuôi file thực tế đang có ở thư mục nguồn">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Quét định dạng file" VerticalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FileExtensionOptions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Extension}" 
                                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" 
                                                          Margin="0,0,14,6" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Real-time File Queue -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="📊 Tiến độ truyền file (Thời gian thực)" FontWeight="Bold" FontSize="13.5" 
                                               Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Clear Queue" HorizontalAlignment="Right" Command="{Binding ClearQueueCommand}" Padding="8,2" FontSize="11"/>
                                </Grid>
                                
                                <DataGrid ItemsSource="{Binding SyncQueue}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" SelectionMode="Single" Height="140"
                                          Background="{StaticResource BgMediumBrush}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1" RowHeight="26"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          HeadersVisibility="Column"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="{StaticResource BgDarkBrush}"
                                          Foreground="{StaticResource TextPrimaryBrush}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="6,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian" Binding="{Binding Time}" Width="75"/>
                                        <DataGridTextColumn Header="Tên tệp tin" Binding="{Binding FileName}" Width="*"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="Thành công">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Thất bại">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Đang truyền">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Chi tiết" Binding="{Binding Details}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── Tab: Rclone Options ─── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA80;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock Text="Cấu hình Rclone" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,4,0">
                    <StackPanel>

                        <!-- Performance -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="🚀 Hiệu suất &amp; Băng thông" FontWeight="Bold" FontSize="14" 
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="Transfers (1-32)"/>
                                        <TextBox Text="{Binding Transfers, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <Label Content="Checkers (1-64)"/>
                                        <TextBox Text="{Binding Checkers, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Label Content="Bandwidth (vd: 1M, 500k)"/>
                                        <TextBox Text="{Binding BandwidthLimit, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Logging -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="📋 Nhật ký chi tiết (Log)" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,10"/>
                                <Label Content="Mức độ log (Log Level)"/>
                                <ComboBox ItemsSource="{Binding LogLevels}" 
                                          SelectedIndex="{Binding SelectedLogLevel}" Width="220"
                                          HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Extra Flags -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="🔧 Tham số nâng cao" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,10"/>
                                <Label Content="Các rclone flag bổ sung (thêm trực tiếp vào câu lệnh)"/>
                                <TextBox Text="{Binding ExtraFlags, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="55" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── Tab: Log Backup ─── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock Text="Log Backup" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📅 Ngày:" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox MinWidth="180" ItemsSource="{Binding LogFiles}"
                                  SelectedItem="{Binding SelectedLogFile}"
                                  Margin="0,0,10,0"/>
                        <Button Command="{Binding LoadBackupLogCommand}" Style="{StaticResource AccentButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="(tối đa 5000 dòng cuối)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Text=" · Đang tải..." FontSize="11"
                                   Foreground="{StaticResource AccentOrangeBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingLog, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <!-- Log content -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding BackupLogContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     TextWrapping="NoWrap"
                                     Padding="12"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── Tab: Cài đặt ─── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE825;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock Text="Cài đặt" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,4,0">
                    <StackPanel>

                        <!-- Rclone -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="🔧 Quản lý Rclone" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                <!-- Path -->
                                <Label Content="Đường dẫn rclone.exe (trống = tự động tìm kiếm trong thư mục chạy app)"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding RclonePath, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}"/>
                                    <Button Grid.Column="1" Width="40" Margin="8,0,0,0"
                                            Command="{Binding BrowseRcloneCommand}" ToolTip="Chọn file rclone.exe">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xED25;" FontSize="14"/>
                                    </Button>
                                </Grid>

                                <!-- Version info -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="Phiên bản hiện tại"/>
                                        <TextBlock Text="{Binding RcloneCurrentVersion}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Phiên bản mới nhất (GitHub)"/>
                                        <TextBlock Text="{Binding RcloneLatestVersion}" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress -->
                                <TextBlock Text="{Binding InstallStatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,4"
                                           Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisConverter}}"/>
                                <ProgressBar Value="{Binding InstallProgress}" Minimum="0" Maximum="100"
                                             Margin="0,0,0,10" Height="6"
                                             Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisConverter}}"/>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding CheckVersionCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Kiểm tra phiên bản" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding InstallRcloneCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tải &amp; Cài rclone" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenRcloneConfigCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mở rclone config" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenRcloneConfigDirCommand}" ToolTip="Mở Explorer đến thư mục chứa file rclone.conf">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xED25;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mở thư mục config" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- App Settings -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="🖥 Thiết lập ứng dụng" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                <CheckBox Content="Ẩn xuống System Tray khi thu nhỏ hoặc đóng cửa sổ"
                                          IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,6"/>
                                <CheckBox Content="Khởi động ứng dụng ở chế độ thu nhỏ"
                                          IsChecked="{Binding StartMinimized}" Margin="0,0,0,6"/>
                                <CheckBox Content="Khởi động cùng Windows (Ghi vào Registry)"
                                          IsChecked="{Binding RunOnStartup}" Margin="0,0,0,14"/>

                                <Button Content="💾 Lưu cài đặt" HorizontalAlignment="Left"
                                        Command="{Binding SaveAppSettingsCommand}"
                                        Style="{StaticResource AccentButton}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ═══ SEPARATOR ═══ -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}" Margin="0,6"/>

        <!-- ═══ LOG OUTPUT ═══ -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEC7A;" FontSize="14" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Output Terminal log" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="80" Height="26" FontSize="11.5" Command="{Binding ClearLogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" 
                         Background="{StaticResource BgMediumBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1" FontFamily="Consolas" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         x:Name="LogListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogEntryColorConverter}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="4" Background="{StaticResource BgMediumBrush}" CornerRadius="6" 
                Padding="14,8" Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" 
                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0"
                            Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Sync cuối: "/><Run Text="{Binding LastSyncTime, Mode=OneWay}"/>
                </TextBlock>

                <Border Grid.Column="3" CornerRadius="4" Padding="10,3"
                        Background="{Binding IsWatching, Converter={StaticResource WatchStatusBrushConverter}}">
                    <TextBlock Text="{Binding IsWatching, Converter={StaticResource WatchStatusTextConverter}}"
                               FontSize="11" FontWeight="Bold" Foreground="#FF121220"/>
                </Border>
            </Grid>
        </Border>

    </Grid>

</Window>
